# Copy to .env and set your own key locally. Never put it in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local defaults. Production uses HTTPS and a persistent disk; see DEPLOYMENT.md.
COASTKIND_HOST=127.0.0.1
PORT=8000
# COASTKIND_DB_PATH=/var/data/coastkind.sqlite3
# COASTKIND_PUBLIC_ORIGIN=https://your-service.onrender.com
# First administrator: set private email and PBKDF2 hash in the host dashboard.
# Never commit real values. The first login must replace the temporary password.
# COASTKIND_ADMIN_EMAIL=
# COASTKIND_ADMIN_PASSWORD_HASH=
